# 环境变量模板（可提交）。
#
# 复制成 .env 后填写真实值：
#   cp .env.example .env         # macOS / Linux
#   Copy-Item .env.example .env  # Windows PowerShell
#
# .env 不会进版本库；这里永远不要写真实密钥。

# ── 数据库 ──────────────────────────────────────────────────────────────
CHILON_DATABASE_URL=postgresql+psycopg://postgres:chilon_test_only@localhost:55432/chilon

# ── DeepSeek 模型 ───────────────────────────────────────────────────────
CHILON_DEEPSEEK_API_KEY=
CHILON_DEEPSEEK_BASE_URL=https://api.deepseek.com
CHILON_DEEPSEEK_MODEL=deepseek-chat
CHILON_DEEPSEEK_TIMEOUT_SECONDS=60
CHILON_DEEPSEEK_MAX_RETRIES=2

# ── 其它 ────────────────────────────────────────────────────────────────
CHILON_REDIS_URL=
CHILON_PLATFORM_RIGHTS_POLICY=A_classroom
CHILON_PLANNER=deepseek

# ── OCR（扫描件解析）──────────────────────────────────────────────────────────
# none = 不启用（默认，扫描件会被拒绝并说明原因）
# fake = 测试用；tesseract = 离线；cloud = 通用 HTTP 端点；aliyun = 阿里云试卷切题
CHILON_OCR_PROVIDER=none
# OCR 置信度低于此值时，版本进 pending_review，教师复核后才可检索
CHILON_OCR_MIN_CONFIDENCE=0.6
CHILON_OCR_LANGUAGES=chi_sim+eng

# 阿里云（开通"教育场景识别"后填写；建议用 RAM 子账号，只授 AliyunOCRFullAccess）
# 开启即意味着整页试卷图片会上传到阿里云，属于数据出境决策
CHILON_OCR_ALIYUN_KEY_ID=
CHILON_OCR_ALIYUN_KEY_SECRET=
CHILON_OCR_ALIYUN_IMAGE_TYPE=scan
CHILON_OCR_ALIYUN_SUBJECT=Math
