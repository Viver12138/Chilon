# 环境变量模板（可提交）。
#
# 复制成 .env 后填写真实值：
#   cp .env.example .env         # macOS / Linux
#   Copy-Item .env.example .env  # Windows PowerShell
#
# .env 不会进版本库；这里永远不要写真实密钥。

# ── 数据库 ──────────────────────────────────────────────────────────────
CHILON_DATABASE_URL=postgresql+psycopg://postgres:chilon_test_only@localhost:55432/chilon

# ── DeepSeek 模型 ───────────────────────────────────────────────────────
CHILON_DEEPSEEK_API_KEY=
CHILON_DEEPSEEK_BASE_URL=https://api.deepseek.com
CHILON_DEEPSEEK_MODEL=deepseek-chat
CHILON_DEEPSEEK_TIMEOUT_SECONDS=60
CHILON_DEEPSEEK_MAX_RETRIES=2

# ── 其它 ────────────────────────────────────────────────────────────────
CHILON_REDIS_URL=
CHILON_PLATFORM_RIGHTS_POLICY=A_classroom
CHILON_PLANNER=deepseek

# ── Qwen / 阿里云百炼（检索 embedding + rerank）─────────────────────────────
# 2026-11-07 决策：质量优先，embedding 用 qwen3.7-text-embedding（1024 维）；
# rerank 也走 API：qwen3.7-text-rerank（替代本地 Qwen3-Reranker-0.6B）
# 密钥获取：百炼控制台 → API-KEY；建议 RAM 子账号，只授模型调用权限
# 官方环境变量 DASHSCOPE_API_KEY 也可直接使用；本项目工具优先读 CHILON_QWEN_API_KEY
CHILON_QWEN_API_KEY=
# DashScope 原生 API（embedding 与 rerank 共用）
# 固定中国区（北京）；本项目不切国际区。控制台请在「华北2（北京）」创建 API-KEY。
CHILON_QWEN_BASE_URL=https://dashscope.aliyuncs.com/api/v1
CHILON_QWEN_REGION=cn-beijing
CHILON_QWEN_TIMEOUT_SECONDS=30
CHILON_QWEN_EMBEDDING_MODEL=qwen3.7-text-embedding
CHILON_QWEN_EMBEDDING_DIM=1024
CHILON_QWEN_RERANK_MODEL=qwen3.7-text-rerank

# 第一版推荐：agent 默认 hybrid H；HR 路由保持 off，只做 shadow/后续灰度
# legacy=旧 SQL；hybrid_h=只用混合 H；auto=QueryPlan 自动 H/HR
CHILON_AGENT_SEARCH_MODE=hybrid_h

# 检索 H/HR 灰度：off=只用 H；shadow=只记录路由、结果仍 H；on=按 percent 路由
CHILON_RETRIEVAL_ROUTER=off
CHILON_RETRIEVAL_ROUTER_PERCENT=100
# shadow/on 的观测 JSONL（query、mode、auto_mode、延迟、空结果、top chunk）
CHILON_RETRIEVAL_SHADOW_LOG=var/retrieval/shadow_events.jsonl
CHILON_RETRIEVAL_SHADOW_MAX_MB=50
CHILON_RETRIEVAL_SHADOW_BACKUPS=3

# 第一版 API/工具保护：单进程内存限流/配额/并发上限
CHILON_RETRIEVAL_RATE_PER_MIN=30
CHILON_RETRIEVAL_DAILY_QUERIES=500
CHILON_RETRIEVAL_DAILY_HR=100
CHILON_RETRIEVAL_MAX_CONCURRENCY=8
CHILON_RETRIEVAL_ACQUIRE_TIMEOUT_SECONDS=5

# 中文文本 LLM 处理统一用 qwen-plus（content_type 预标、中文语义辅助、判定等）
CHILON_QWEN_CHAT_MODEL=qwen-plus
CHILON_QWEN_CHAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 送进 rerank 的候选数（与本地评测的 rerank_candidates=40 对齐）
CHILON_QWEN_RERANK_TOP_N=40

# ── OCR（扫描件解析）──────────────────────────────────────────────────────────
# none = 不启用（默认，扫描件会被拒绝并说明原因）
# fake = 测试用；tesseract = 离线；cloud = 通用 HTTP 端点；aliyun = 阿里云试卷切题
CHILON_OCR_PROVIDER=none
# OCR 置信度低于此值时，版本进 pending_review，教师复核后才可检索
CHILON_OCR_MIN_CONFIDENCE=0.6
CHILON_OCR_LANGUAGES=chi_sim+eng

# 阿里云（开通"教育场景识别"后填写；建议用 RAM 子账号，只授 AliyunOCRFullAccess）
# 开启即意味着整页试卷图片会上传到阿里云，属于数据出境决策
CHILON_OCR_ALIYUN_KEY_ID=
CHILON_OCR_ALIYUN_KEY_SECRET=
CHILON_OCR_ALIYUN_IMAGE_TYPE=scan
CHILON_OCR_ALIYUN_SUBJECT=Math
