{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chilon.local/schemas/teacher_questions.v2.schema.json",
  "title": "Chilon 真实教师问题集 v2（teacher-questions/v2）",
  "description": "检索评测问题集 v2：在 v1 的 expect.any 之外，把 expect.strict 升级为数据库 chunk_id 金标集合。结构定义见本文件；收集流程与配额见 corpus/eval/V2_COLLECTION_GUIDE.md；结构校验见 tools/check_teacher_questions_v2.py。",
  "type": "object",
  "required": ["version", "provenance", "queries"],
  "properties": {
    "version": {
      "const": "teacher-questions/v2"
    },
    "note": {
      "type": "string"
    },
    "template": {
      "type": "boolean",
      "description": "true 表示这是空白收集模板，不是可评测问题集；模板允许 text/expect.any 为空。"
    },
    "instructions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "collection_protocol": {
      "type": "object",
      "description": "收集流程与配额（可选，模板里给出建议值）",
      "additionalProperties": true
    },
    "strict_quota": {
      "type": "object",
      "description": "strict 金标计划配额；v2.0 建议 8/6/6/10，共 30 条",
      "properties": {
        "definition": { "type": "integer", "minimum": 0 },
        "theorem": { "type": "integer", "minimum": 0 },
        "formula": { "type": "integer", "minimum": 0 },
        "question": { "type": "integer", "minimum": 0 },
        "example": { "type": "integer", "minimum": 0 },
        "section": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["status", "real_teacher_confirmed"],
      "properties": {
        "status": {
          "enum": ["real_teacher", "simulated", "template", "developer_authored_legacy", "unknown"],
          "description": "real_teacher 才允许产出可信基线"
        },
        "real_teacher_confirmed": {
          "type": "boolean"
        },
        "collected_by": { "type": "string" },
        "collected_at": { "type": "string" },
        "contributors": {
          "type": "array",
          "items": { "type": "string" },
          "description": "教师匿名 ID / 背景（如 T01 高三/教龄 3 年/未用过系统）"
        },
        "note": { "type": "string" }
      },
      "additionalProperties": true
    },
    "queries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "description": "v2.0 目标 60 条（五类各 12）；v2.1 长期 ≥100 条 strict（总数可继续扩）",
      "items": { "$ref": "#/$defs/query" }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "clause": {
      "description": "lenient 命中子句。字符串是 {field:text, contains:字符串} 的简写。any 数组内是 OR；子句内部的 all 是 AND。",
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "$ref": "#/$defs/simple_clause" },
        { "$ref": "#/$defs/all_clause" }
      ]
    },
    "simple_clause": {
      "type": "object",
      "properties": {
        "field": {
          "enum": ["text", "excerpt", "title", "knowledge_points", "year", "paper", "source_type"],
          "default": "text",
          "description": "text = 块摘要 + 来源标题；其余为对应命中字段"
        },
        "contains": {
          "type": "string",
          "minLength": 1,
          "description": "子串匹配（区分大小写，必须与语料原文一致）"
        },
        "equals": {
          "type": "string",
          "description": "精确相等；knowledge_points 时为标签成员判断"
        },
        "object": {
          "enum": ["any", "chunk", "question", "paragraph"],
          "default": "any",
          "description": "对象约束：question = 题目块；paragraph = 正文块；chunk/any = 任意块"
        },
        "note": { "type": "string" }
      },
      "oneOf": [
        { "required": ["contains"] },
        { "required": ["equals"] }
      ],
      "additionalProperties": false
    },
    "all_clause": {
      "type": "object",
      "required": ["all"],
      "properties": {
        "all": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/clause" }
        },
        "note": { "type": "string" }
      },
      "additionalProperties": false
    },
    "strict_gold": {
      "type": "object",
      "description": "严格金标：该查询唯一确定对象在数据库中的 chunk_id 集合。一个题目/教材定义被切成多块时，chunk_ids 是这些块的集合；评测时 top-8 至少命中一个即 Strict Recall@8 命中，全部命中才算 Strict-all@8。",
      "required": ["chunk_ids", "object_type", "rationale"],
      "properties": {
        "chunk_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 },
          "description": "knowledge_chunks.id（UUID）；从冻结 DB 快照导出，不靠片段猜测"
        },
        "object_type": {
          "enum": ["definition", "theorem", "formula", "question", "example", "section"],
          "description": "definition=教材定义；theorem=定理/性质；formula=公式；question=完整题目（题干块）；example/section=例题/知识点页"
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "description": "为什么这些 chunk 是标准答案；多块时说明每块的角色（题干/定义/定理）"
        },
        "verified_by": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "description": "核验人匿名 ID（至少 1 人；v2.0 要求 2 人独立核验）"
        },
        "verified_at": {
          "type": "string",
          "description": "核验日期 YYYY-MM-DD"
        }
      },
      "additionalProperties": false
    },
    "expect": {
      "type": "object",
      "required": ["any"],
      "properties": {
        "any": {
          "type": "array",
          "description": "lenient 口径：任一子句命中即算相关命中。模板允许为空；可评测数据必须 ≥1。",
          "items": { "$ref": "#/$defs/clause" }
        },
        "strict": {
          "description": "strict 口径：null 表示该条不参与 strict 指标；对象为 chunk_id 金标。",
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/strict_gold" }
          ]
        }
      },
      "additionalProperties": false
    },
    "query": {
      "type": "object",
      "required": ["id", "category", "text", "origin", "object_type", "expect", "expect_verified", "strict_verified"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "description": "全文件唯一，例如 Q-A-01 / Q-C-08"
        },
        "category": {
          "enum": ["主题词", "题型+知识点", "教材概念", "年份+卷别", "自然语言要求"]
        },
        "text": {
          "type": "string",
          "description": "教师原话（逐字记录，不改写成系统友好关键词）。模板位为空字符串。"
        },
        "origin": {
          "enum": ["teacher", "simulated_candidate"],
          "description": "teacher 才进入默认评分；simulated_candidate 必须写 notes 说明未经真人确认"
        },
        "contributor": {
          "type": "string",
          "description": "教师匿名 ID + 背景，例如 T01/高三/教龄 3 年/未用过系统"
        },
        "collected_at": {
          "type": "string",
          "description": "收集日期 YYYY-MM-DD"
        },
        "object_type": {
          "enum": ["any", "question", "chunk", "knowledge_point"],
          "description": "这条问题想要的对象类型（用于覆盖率统计）；实际 strict 对象类型见 expect.strict.object_type"
        },
        "intent": {
          "enum": ["find_topic", "find_question", "find_concept", "find_by_year", "find_by_type", "natural_language"],
          "description": "检索意图（可选；便于分类统计）"
        },
        "expect": { "$ref": "#/$defs/expect" },
        "expect_verified": {
          "type": "boolean",
          "description": "expect.any 是否已在语料中用 SQL 核验。false 会让报告标记为不可信基线。"
        },
        "strict_verified": {
          "type": "boolean",
          "description": "expect.strict 是否已由两位核验人独立核验；strict 非 null 时必须为 true。"
        },
        "strict_plan": {
          "enum": ["definition", "theorem", "formula", "question", "example", "section", null],
          "description": "仅模板使用：该槽位计划采集的 strict 对象类型；null 表示 any-only。"
        },
        "notes": { "type": "string" },
        "fill_hint": {
          "type": "string",
          "description": "仅模板使用：这一槽位该填什么。"
        }
      },
      "additionalProperties": false
    }
  }
}
