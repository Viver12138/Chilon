        {
          "name": "created_by",
          "type": "uuid",
          "nullable": false,
          "sensitivity": "internal",
          "desc": "创建者"
        },
        {
          "name": "created_at",
          "type": "timestamptz",
          "nullable": false,
          "default": "now()",
          "sensitivity": "public",
          "desc": "创建时间"
        },
        {
          "name": "updated_at",
          "type": "timestamptz",
          "nullable": false,
          "default": "now()",
          "sensitivity": "public",
          "desc": "更新时间"
        },
        {
          "name": "deleted_at",
          "type": "timestamptz",
          "nullable": true,
          "sensitivity": "public",
          "desc": "软删除"
        }
      ],
      "constraints": [
        {
          "type": "check",
          "name": "ck_materials_document_kind",
          "expr": "document_kind IN ('lesson','exercise_set','worksheet','mixed')"
        }
      ],
      "indexes": [
        {
          "name": "ix_materials_owner",
          "columns": [
            "owner_id",
            "updated_at"
          ],
          "where": "deleted_at IS NULL"
        },
        {
          "name": "ix_materials_project",
          "columns": [
            "primary_project_id"
          ],
          "where": "deleted_at IS NULL"
        }
      ],
      "policies": [
        {
          "name": "pol_materials_owner",
          "command": "ALL",
          "using": "owner_id = public.app_current_user_id()",
          "with_check": "owner_id = public.app_current_user_id()"
        }
      ]
    },
    {
      "name": "material_versions",
      "purpose": "不可变正式版本；修改必须创建新版本",
      "owner_scoped": true,
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "nullable": false,
          "primary_key": true,
          "sensitivity": "public",
          "desc": "主键"
        },
        {
          "name": "material_id",
          "type": "uuid",
          "nullable": false,
          "fk": {
            "table": "materials",
            "on_delete": "RESTRICT"
          },
          "sensitivity": "public",
          "desc": "所属材料"
        },
        {
          "name": "owner_id",
          "type": "uuid",
          "nullable": false,
          "sensitivity": "internal",
          "desc": "归属教师（冗余用于 RLS）",
          "fk": {
            "table": "users",
            "on_delete": "RESTRICT"
          }
        },
        {
          "name": "version_no",
          "type": "integer",
          "nullable": false,
          "sensitivity": "public",
          "desc": "材料内递增版本号"
        },
        {
          "name": "document_schema_version",
          "type": "varchar",
          "length": 20,
          "nullable": false,
          "sensitivity": "public",
          "desc": "固定不迁移"
        },
        {
          "name": "document_content",
          "type": "jsonb",
          "nullable": false,
          "sensitivity": "confidential",
          "desc": "AST 快照"
        },
        {
          "name": "content_hash",
          "type": "sha256",
          "nullable": false,
          "sensitivity": "internal",
          "desc": "canonical JSON 的 SHA-256"
        },
        {
          "name": "change_summary",
          "type": "text",
          "nullable": true,
          "sensitivity": "internal",
          "desc": "相对上一版本的变更说明"
        },
        {
          "name": "source_draft_revision_id",
          "type": "uuid",
          "nullable": true,
          "deferred_fk": {
            "table": "material_draft_revisions",
            "on_delete": "SET NULL"
          },
          "sensitivity": "public",
          "desc": "来源草稿 Revision"
        },
        {
          "name": "publication_approval_id",
          "type": "uuid",
          "nullable": true,
          "deferred_fk": {
            "table": "material_publication_approvals",
            "on_delete": "RESTRICT"
          },
          "sensitivity": "internal",
          "desc": "发布审批（单次消费）"
        },
        {
          "name": "idempotency_key",
          "type": "varchar",
          "length": 255,
          "nullable": false,
          "sensitivity": "internal",
          "desc": "发布幂等键，防止重复建版本"
        },
        {
          "name": "created_by",
          "type": "uuid",
          "nullable": false,
          "sensitivity": "internal",
          "desc": "创建者"
        },
        {
          "name": "created_at",
          "type": "timestamptz",
          "nullable": false,
          "default": "now()",
          "sensitivity": "public",
          "desc": "创建时间"
        }
      ],
      "constraints": [
        {
          "type": "unique",
          "name": "uq_material_versions_material_version",
          "columns": [
            "material_id",
            "version_no"
          ]
        },
        {
          "type": "unique",
          "name": "uq_material_versions_idempotency",
          "columns": [
            "owner_id",
            "idempotency_key"
          ]
        }
      ],
      "indexes": [
        {
          "name": "ix_material_versions_material",
          "columns": [
            "material_id",
            "version_no"
          ]
        }
      ],
      "policies": [
        {
          "name": "pol_material_versions_owner",
          "command": "ALL",
          "using": "owner_id = public.app_current_user_id()",
          "with_check": "owner_id = public.app_current_user_id()"
        }
      ]
    },
    {
      "name": "material_drafts",
      "purpose": "可编辑草稿；基版本、当前 Revision 指针与状态机",
      "owner_scoped": true,
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "nullable": false,
          "primary_key": true,
          "sensitivity": "public",
          "desc": "主键"
        },
        {
          "name": "material_id",
          "type": "uuid",
          "nullable": false,
          "fk": {
            "table": "materials",
            "on_delete": "RESTRICT"
          },
          "sensitivity": "public",
          "desc": "所属材料"
        },
        {
          "name": "owner_id",
          "type": "uuid",
          "nullable": false,
          "sensitivity": "internal",
          "desc": "归属教师",
          "fk": {
            "table": "users",
            "on_delete": "RESTRICT"
          }
        },
        {
          "name": "base_version_id",
          "type": "uuid",
          "nullable": true,
          "fk": {
            "table": "material_versions",
            "on_delete": "RESTRICT"
          },
          "sensitivity": "public",
          "desc": "基版本；为空表示全新材料"
        },
        {
          "name": "current_revision_id",
          "type": "uuid",
          "nullable": true,
          "deferred_fk": {
            "table": "material_draft_revisions",
            "on_delete": "SET NULL"
          },
          "sensitivity": "public",
          "desc": "当前 Revision 指针"
        },
        {
          "name": "current_revision_no",
          "type": "integer",
          "nullable": false,
          "default": "0",
          "sensitivity": "public",
          "desc": "当前 Revision 序号"
        },
        {
          "name": "current_content_hash",
          "type": "sha256",
          "nullable": true,
          "sensitivity": "internal",
          "desc": "当前内容 Hash，用于 ETag 与门禁新鲜度"
        },
        {
          "name": "status",
          "type": "varchar",
          "length": 32,
          "nullable": false,
          "default": "'editing'",
          "sensitivity": "public",
          "desc": "草稿状态机"
        },
        {
          "name": "state_version",
          "type": "integer",
          "nullable": false,
          "default": "0",
          "sensitivity": "public",
          "desc": "CAS 版本，单调递增"
        },
        {
          "name": "state_changed_at",
          "type": "timestamptz",
          "nullable": false,
          "default": "now()",
          "sensitivity": "public",
          "desc": "状态变更时间"
        },
        {
          "name": "status_reason_code",
          "type": "varchar",
          "length": 80,
          "nullable": true,
          "sensitivity": "public",
          "desc": "状态原因码"
        },
        {
          "name": "status_reason",
          "type": "text",
          "nullable": true,
          "sensitivity": "internal",
          "desc": "状态原因说明"
        },
        {
          "name": "created_by",
          "type": "uuid",
          "nullable": false,
          "sensitivity": "internal",
          "desc": "创建者"
        },
        {
          "name": "created_at",
          "type": "timestamptz",
          "nullable": false,
          "default": "now()",
          "sensitivity": "public",
          "desc": "创建时间"
        },
        {
          "name": "updated_at",
          "type": "timestamptz",
          "nullable": false,
          "default": "now()",
          "sensitivity": "public",
          "desc": "更新时间"
        }
      ],
      "constraints": [
        {
          "type": "check",
          "name": "ck_material_drafts_status",
          "expr": "status IN ('editing','checking','changes_required','awaiting_review','approved','needs_rebase','needs_attention','published','abandoned','superseded')"
        },
        {
          "type": "check",
          "name": "ck_material_drafts_state_version",
          "expr": "state_version >= 0 AND current_revision_no >= 0"
        }
      ],
      "indexes": [
        {
          "name": "ix_material_drafts_material",
          "columns": [
            "material_id",
            "status"
          ]
        },
        {
          "name": "ix_material_drafts_owner_status",
          "columns": [
            "owner_id",
            "status"
          ]
        }
      ],
      "policies": [
        {
          "name": "pol_material_drafts_owner",
          "command": "ALL",
          "using": "owner_id = public.app_current_user_id()",
          "with_check": "owner_id = public.app_current_user_id()"
        }
      ]
    },
