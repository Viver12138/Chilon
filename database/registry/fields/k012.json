{
  "module": "K012",
  "title": "Project & Material",
  "registry_version": "0.1.0",
  "status": "DESIGNED",
  "source_docs": [
    "Chilon_Project_Design_Master_Document.md §16、§21.7、§21.9、§21.10",
    "design/Chilon_Design_Volume_D1_Product_Closure_Protocol.md §4",
    "design/Chilon_Design_Volume_D3_Page_Specifications.md"
  ],
  "tables": [
    {
      "name": "projects",
      "purpose": "教学专题；一个 Project 对应一个教学专题",
      "owner_scoped": true,
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "nullable": false,
          "primary_key": true,
          "sensitivity": "public",
          "desc": "主键"
        },
        {
          "name": "owner_id",
          "type": "uuid",
          "nullable": false,
          "sensitivity": "internal",
          "desc": "归属教师",
          "fk": {
            "table": "users",
            "on_delete": "RESTRICT"
          }
        },
        {
          "name": "name",
          "type": "varchar",
          "length": 160,
          "nullable": false,
          "sensitivity": "internal",
          "desc": "专题名"
        },
        {
          "name": "description",
          "type": "text",
          "nullable": true,
          "sensitivity": "internal",
          "desc": "说明"
        },
        {
          "name": "subject",
          "type": "varchar",
          "length": 32,
          "nullable": false,
          "default": "'mathematics'",
          "sensitivity": "public",
          "desc": "学科"
        },
        {
          "name": "grade",
          "type": "varchar",
          "length": 32,
          "nullable": false,
          "default": "'senior_high'",
          "sensitivity": "public",
          "desc": "年级"
        },
        {
          "name": "cover_storage_key",
          "type": "varchar",
          "length": 500,
          "nullable": true,
          "sensitivity": "confidential",
          "desc": "封面图 Key（候选字段，待确认是否纳入）"
        },
        {
          "name": "status",
          "type": "varchar",
          "length": 16,
          "nullable": false,
          "default": "'active'",
          "sensitivity": "public",
          "desc": "active / archived"
        },
        {
          "name": "archived_at",
          "type": "timestamptz",
          "nullable": true,
          "sensitivity": "public",
          "desc": "归档时间；归档不自动归档其 Material"
        },
        {
          "name": "created_by",
          "type": "uuid",
          "nullable": false,
          "sensitivity": "internal",
          "desc": "创建者"
        },
        {
          "name": "created_at",
          "type": "timestamptz",
          "nullable": false,
          "default": "now()",
          "sensitivity": "public",
          "desc": "创建时间"
        },
        {
          "name": "updated_at",
          "type": "timestamptz",
          "nullable": false,
          "default": "now()",
          "sensitivity": "public",
          "desc": "更新时间"
        },
        {
          "name": "deleted_at",
          "type": "timestamptz",
          "nullable": true,
          "sensitivity": "public",
          "desc": "软删除；删除走专门 Workflow，不级联材料"
        }
      ],
      "constraints": [
        {
          "type": "check",
          "name": "ck_projects_status",
          "expr": "status IN ('active','archived')"
        }
      ],
      "indexes": [
        {
          "name": "ix_projects_owner",
          "columns": [
            "owner_id",
            "status",
            "updated_at"
          ],
          "where": "deleted_at IS NULL"
        }
      ],
      "policies": [
        {
          "name": "pol_projects_owner",
          "command": "ALL",
          "using": "owner_id = public.app_current_user_id()",
          "with_check": "owner_id = public.app_current_user_id()"
        }
      ]
    },
    {
