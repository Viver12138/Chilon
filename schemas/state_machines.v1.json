        { "id": "D22", "from": "needs_rebase", "to": "editing", "trigger": "rebase", "guard": "完成显式 Rebase 并产生新 Revision", "effects": [] },
        { "id": "D23", "from": "needs_rebase", "to": "abandoned", "trigger": "abandon", "guard": "教师放弃", "effects": [] },
