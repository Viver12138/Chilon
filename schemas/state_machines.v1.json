        { "id": "D25", "from": ["editing", "checking", "changes_required", "awaiting_review", "approved", "needs_attention", "needs_rebase"], "to": "superseded", "trigger": "supersede", "guard": "教师明确选择另一 Draft 替代", "effects": [] }
      ],
      "invariants": [
        { "id": "D-INV1", "text": "published、abandoned、superseded 为终止态。", "source": "§21.7.1" },
        { "id": "D-INV2", "text": "发布不设置持久化的 publishing 状态；approved → published 在一个 PostgreSQL 事务中完成，失败回滚保持 approved。", "source": "§21.7.1" },
        { "id": "D-INV3", "text": "任何新 Revision 都会使基于旧 Revision 的检查、教师审核和发布授权失效。", "source": "§21.7.1" },
        { "id": "D-INV4", "text": "checking 期间允许编辑，但新 Revision 立即把 Draft 拉回 editing；旧检查结果标记 stale，不参与发布门禁。", "source": "§21.7.1" },
        { "id": "D-INV5", "text": "发布成功不修改 Material Base Version；后续修改必须新建 Draft。", "source": "§21.7.1" }
      ]
