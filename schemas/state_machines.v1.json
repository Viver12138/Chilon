        { "id": "ST04", "from": "paused", "to": "running", "trigger": "resume", "guard": "Execution 恢复", "effects": [] },
        { "id": "ST05", "from": "running", "to": "succeeded", "trigger": "step_succeeded", "guard": "Step 执行成功", "effects": [] },
        { "id": "ST06", "from": "running", "to": "failed", "trigger": "step_failed", "guard": "Step 明确失败", "effects": [] },
        { "id": "ST07", "from": ["pending", "ready"], "to": "blocked", "trigger": "upstream_failed", "guard": "上游失败导致无法继续", "effects": ["不得错误标记为 failed"] },
        { "id": "ST08", "from": ["pending", "ready"], "to": "skipped", "trigger": "skip", "guard": "可选 Step 按规则跳过", "effects": ["必须记录原因和规则"] },
        { "id": "ST09", "from": ["pending", "ready", "running", "paused"], "to": "cancelled", "trigger": "cancel", "guard": "Execution 取消", "effects": [] },
        { "id": "ST10", "from": ["pending", "ready", "running", "paused", "blocked"], "to": "superseded", "trigger": "supersede", "guard": "Execution 被替换", "effects": [] }
      ],
