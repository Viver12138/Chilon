{
  "schema": "chilon.state_machines",
  "schema_version": "1.0.0",
  "title": "Chilon State Machine Registry v1",
  "source": "Chilon_Project_Design_Master_Document.md §21.4–§21.11",
  "freeze_status": "FROZEN FOR IMPLEMENTATION",
  "updated_at": "2026-11-04",
  "notes": [
    "本文件是 §21 状态机的机器可读权威副本。与主文档冲突时，先核对主文档并同步两边，不得只改一边。",
    "transition.trigger 是本轮提出的动作标识，供 D4/D5 的 API 与错误码对齐；正式冻结在 D4。",
    "from 可以是单个状态或状态数组；数组表示该行在文档中合并了多个起始状态。"
  ],
  "governing_fields": {
    "status": "status",
    "state_version": "state_version",
    "state_changed_at": "state_changed_at",
    "status_reason_code": "status_reason_code",
    "status_reason_optional": "status_reason"
  },
  "common_rules": [
    {
      "id": "SM-R01",
      "title": "服务端权威",
      "text": "客户端只能发送业务动作（如 submit_plan、approve_plan、request_cancel），不能直接写 status。",
      "source": "§21.4.2#1"
    },
    {
      "id": "SM-R02",
      "title": "CAS 更新",
      "text": "状态变更使用 UPDATE ... WHERE id AND status = expected_status AND state_version = expected_state_version；受影响行数不为 1 时返回冲突，不得退化为最后写入者胜出。",
      "source": "§21.4.2#2"
    },
    {
      "id": "SM-R03",
      "title": "状态字段",
      "text": "可变聚合至少包含 status、state_version、state_changed_at、status_reason_code 与可选 status_reason；state_version 单调递增，并与内容 Revision 分开。",
      "source": "§21.4.2#3"
    },
    {
      "id": "SM-R04",
      "title": "事件同事务",
      "text": "状态更新、业务事件与 Outbox 写入必须处于同一 PostgreSQL 事务。",
      "source": "§21.4.2#4"
    },
    {
      "id": "SM-R05",
      "title": "终止态不可复活",
      "text": "终止状态不可修改；重试创建新的 Attempt/Execution/Export，不把旧记录改回运行中。",
      "source": "§21.4.2#5"
    },
    {
      "id": "SM-R06",
      "title": "不推断状态",
      "text": "Celery job 状态、Redis Key、Harness Event、SSE 连接状态均不得作为业务状态事实来源。",
      "source": "§21.4.2#6"
    },
    {
      "id": "SM-R07",
      "title": "输入固定",
      "text": "审批与执行必须固定 Requirement Version、Plan Version、Plan Hash、Document Schema Version、Rule Snapshot、Tool Registry Hash 与模型/运行时配置。",
      "source": "§21.4.2#7"
    },
    {
      "id": "SM-R08",
      "title": "派生状态不重复存储",
      "text": "如“质量报告是否过期”由目标 Hash 与当前 Draft Revision 比较得出，不得依赖前端显示或手写布尔值。",
      "source": "§21.4.2#8"
    },
    {
      "id": "SM-R09",
      "title": "超时不等于失败",
      "text": "Worker 失联、工具超时或 Harness 无响应时先进入可协调状态，查询实际效果后再判定。",
      "source": "§21.4.2#9"
    },
    {
      "id": "SM-R10",
      "title": "状态可见性与内部状态分离",
      "text": "教师可见 Activity 可聚合内部状态，但不得把 Harness 内部推理、Token 或未过滤事件映射为业务状态。",
      "source": "§21.4.2#10"
    }
  ],
  "aggregates": [
    {
      "id": "task",
      "title": "Task",
      "module": "K011",
      "entity": "tasks",
      "status_field": "tasks.status",
      "initial_states": ["draft"],
      "terminal_states": ["completed", "cancelled"],
      "states": [
        "draft",
        "planning",
        "awaiting_plan_approval",
        "ready",
        "running",
        "completed",
        "needs_attention",
        "cancelling",
        "cancelled"
      ],
      "source": "§21.5.1",
      "transitions": [
        { "id": "T01", "from": "draft", "to": "planning", "trigger": "submit_requirement", "guard": "提交有效 Requirement Version", "effects": ["固定 Requirement Version"] },
        { "id": "T02", "from": "planning", "to": "awaiting_plan_approval", "trigger": "plan_validated", "guard": "Plan 通过结构、DAG、Capability 与来源快照校验", "effects": ["创建 Plan Version 与审批请求"] },
        { "id": "T03", "from": "planning", "to": "needs_attention", "trigger": "planning_failed", "guard": "重试耗尽、输入不足或不可恢复错误", "effects": ["记录错误码和可恢复动作"] },
        { "id": "T04", "from": "awaiting_plan_approval", "to": "ready", "trigger": "approve_plan", "guard": "教师批准与当前 Plan Hash 匹配的 Approval", "effects": ["固化 Approval"] },
        { "id": "T05", "from": "awaiting_plan_approval", "to": "planning", "trigger": "request_plan_revision", "guard": "教师要求修改 Plan", "effects": ["旧 Plan Version 标记 superseded"] },
        { "id": "T06", "from": "awaiting_plan_approval", "to": "planning", "trigger": "plan_expired", "guard": "Plan/Approval 过期或失效", "effects": ["不创建 Execution"] },
        { "id": "T07", "from": "awaiting_plan_approval", "to": "cancelled", "trigger": "cancel", "guard": "教师取消", "effects": ["不创建 Execution"] },
        { "id": "T08", "from": "ready", "to": "running", "trigger": "start_execution", "guard": "创建 Execution 并成功入队", "effects": ["记录当前 Execution ID"] },
        { "id": "T09", "from": "ready", "to": "needs_attention", "trigger": "enqueue_failed", "guard": "入队失败或 Execution 创建失败", "effects": ["记录可重试错误"] },
        { "id": "T10", "from": "ready", "to": "planning", "trigger": "approval_invalidated", "guard": "Plan/Approval 在执行前失效", "effects": ["创建新的 Plan 版本"] },
        { "id": "T11", "from": "running", "to": "completed", "trigger": "delivery_complete", "guard": "所有必需 Draft 已持久化并完成交付，无活跃 Execution", "effects": ["记录交付物 ID"] },
        { "id": "T12", "from": "running", "to": "needs_attention", "trigger": "execution_failed", "guard": "Execution 失败、结果不确定或阻塞", "effects": ["记录原因和当前 Execution ID"] },
        { "id": "T13", "from": "running", "to": "awaiting_plan_approval", "trigger": "plan_invalidated", "guard": "Plan 因输入、工具或策略变化失效，并已停止活跃执行", "effects": ["生成或选择新的 Plan Version"] },
        { "id": "T14", "from": "needs_attention", "to": "planning", "trigger": "replan", "guard": "教师发起重新规划", "effects": ["创建新的 Requirement/Plan 版本"] },
        { "id": "T15", "from": "needs_attention", "to": "ready", "trigger": "retry", "guard": "Plan 仍有效，教师重试", "effects": ["旧 Attempt 保留"] },
        { "id": "T16", "from": "needs_attention", "to": "cancelled", "trigger": "cancel", "guard": "教师取消", "effects": ["所有子执行必须终止或超时协调"] },
        { "id": "T17", "from": ["draft", "planning", "awaiting_plan_approval", "ready"], "to": "cancelled", "trigger": "cancel", "guard": "教师取消且无活跃副作用", "effects": [] },
        { "id": "T18", "from": "running", "to": "cancelling", "trigger": "request_cancel", "guard": "教师请求取消", "effects": ["创建取消命令"] },
        { "id": "T19", "from": "cancelling", "to": "cancelled", "trigger": "cancellation_confirmed", "guard": "所有 Execution 已终止或确认无副作用", "effects": ["写入终止事件"] },
        { "id": "T20", "from": "cancelling", "to": "needs_attention", "trigger": "cancellation_unresolved", "guard": "超过取消协调期限且结果不确定", "effects": ["保留 cancel_pending 标记并告警"] }
      ],
      "invariants": [
        { "id": "T-INV1", "text": "completed 表示 Agent 已完成交付，不表示 Draft 已发布；Draft 的审核与发布由 Draft 状态机独立管理。", "source": "§21.5.1" },
        { "id": "T-INV2", "text": "进入 completed 前必须满足：所有必需 Draft 已持久化、初轮质量与数学检查已达终态并绑定具体 Draft Revision、无待写入输出副作用。该证据不构成发布门禁证据。", "source": "§21.5.1" },
        { "id": "T-INV3", "text": "completed 是终止态；Draft 内的局部修改不重开 Task。需要重新检索或多步骤生成时创建新 Task，可用 parent_task_id 保留来源。", "source": "§21.5.1" },
        { "id": "T-INV4", "text": "MVP 中同一 Task 最多存在一个非终止 Execution。", "source": "§21.5.1" }
      ]
    },
    {
      "id": "requirement_version",
      "title": "Requirement Version",
      "module": "K011",
      "entity": "task_requirement_versions",
      "status_field": "task_requirement_versions.status",
      "initial_states": ["draft"],
      "terminal_states": ["superseded", "abandoned"],
      "states": ["draft", "active", "superseded", "abandoned"],
      "source": "§21.5.2",
      "transitions": [
        { "id": "R01", "from": "draft", "to": "active", "trigger": "submit", "guard": "提交时完成 Schema 校验并计算 Hash", "effects": ["active 后不可修改"] },
        { "id": "R02", "from": "draft", "to": "abandoned", "trigger": "abandon", "guard": "教师放弃未提交版本", "effects": [] },
        { "id": "R03", "from": "active", "to": "superseded", "trigger": "supersede", "guard": "教师创建新版本；若已有批准 Plan 或活跃 Execution，必须先回到 planning 或完成取消协调", "effects": [] }
      ],
      "invariants": [
        { "id": "R-INV1", "text": "同一 Task 最多一个 draft 和一个 active Requirement Version。", "source": "§21.5.2" },
        { "id": "R-INV2", "text": "Plan、Execution 与 Draft 必须保存创建时使用的 requirement_version_id 与 Hash。", "source": "§21.5.2" }
      ]
    },
    {
      "id": "plan_version",
      "title": "Plan Version",
      "module": "K011",
      "entity": "agent_plan_versions",
      "status_field": "agent_plan_versions.status",
      "initial_states": ["draft"],
      "terminal_states": ["rejected", "expired", "invalidated", "superseded"],
      "states": ["draft", "awaiting_approval", "approved", "rejected", "expired", "invalidated", "superseded"],
      "source": "§21.5.3",
      "transitions": [
        { "id": "PV01", "from": "draft", "to": "awaiting_approval", "trigger": "validate_plan", "guard": "校验通过并计算 Plan Hash", "effects": [] },
        { "id": "PV02", "from": "awaiting_approval", "to": "approved", "trigger": "approve", "guard": "Approval 为 approved 且 Hash 一致", "effects": [] },
        { "id": "PV03", "from": "awaiting_approval", "to": "rejected", "trigger": "reject", "guard": "教师拒绝", "effects": [] },
        { "id": "PV04", "from": "awaiting_approval", "to": "expired", "trigger": "expire", "guard": "超过 expires_at", "effects": [] },
        { "id": "PV05", "from": "awaiting_approval", "to": "superseded", "trigger": "supersede", "guard": "生成新 Plan Version", "effects": [] },
        { "id": "PV06", "from": "awaiting_approval", "to": "invalidated", "trigger": "invalidate", "guard": "输入或依赖 Hash 失效", "effects": [] },
        { "id": "PV07", "from": "approved", "to": "superseded", "trigger": "supersede", "guard": "Execution 尚未启动且出现新批准 Plan", "effects": [] },
        { "id": "PV08", "from": "approved", "to": "invalidated", "trigger": "invalidate", "guard": "审批被撤销、输入变化或关键版本不再匹配", "effects": [] }
      ],
      "invariants": [
        { "id": "PV-INV1", "text": "draft 校验失败时不持久化为可执行 Plan。", "source": "§21.5.3" }
      ]
    },
    {
      "id": "plan_approval",
      "title": "Plan Approval",
      "module": "K011",
      "entity": "agent_plan_approvals",
      "status_field": "agent_plan_approvals.status",
      "initial_states": ["pending"],
      "terminal_states": ["rejected", "revoked", "invalidated", "expired"],
      "states": ["pending", "approved", "rejected", "revoked", "invalidated", "expired"],
      "source": "§21.5.3",
      "transitions": [
        { "id": "PA01", "from": "pending", "to": "approved", "trigger": "approve", "guard": "教师批准", "effects": [] },
        { "id": "PA02", "from": "pending", "to": "rejected", "trigger": "reject", "guard": "教师拒绝", "effects": [] },
        { "id": "PA03", "from": "pending", "to": "expired", "trigger": "expire", "guard": "超过审批期限", "effects": [] },
        { "id": "PA04", "from": "approved", "to": "revoked", "trigger": "revoke", "guard": "仅在尚未启动 Execution 时允许", "effects": [] },
        { "id": "PA05", "from": "approved", "to": "invalidated", "trigger": "invalidate", "guard": "Plan Hash、Requirement、来源快照或审批期限发生变化", "effects": [] }
      ],
      "invariants": [
        { "id": "PA-INV1", "text": "Approval 必须绑定 plan_version_id、plan_hash、requirement_version_id、审批人、审批时间与可选期限。", "source": "§21.5.3" },
        { "id": "PA-INV2", "text": "Execution 启动前必须重新检查 Plan 仍为 approved、Approval 仍有效、Hash 一致且 Requirement Version 未失效。", "source": "§21.5.3" }
      ]
    },
    {
      "id": "execution",
      "title": "Execution",
      "module": "K011",
      "entity": "agent_executions",
      "status_field": "agent_executions.status",
      "initial_states": ["queued"],
      "terminal_states": ["succeeded", "failed", "cancelled", "superseded"],
      "states": [
        "queued",
        "starting",
        "running",
        "pause_requested",
        "paused",
        "cancel_requested",
        "cancelling",
        "outcome_unknown",
        "succeeded",
        "failed",
        "cancelled",
        "superseded"
      ],
      "source": "§21.6.1",
      "transitions": [
        { "id": "E01", "from": "queued", "to": "starting", "trigger": "acquire_lease", "guard": "取得 Lease + Fencing Token，Plan/Approval 复核通过", "effects": [] },
        { "id": "E02", "from": "queued", "to": "cancelled", "trigger": "cancel", "guard": "启动前教师取消", "effects": [] },
        { "id": "E03", "from": "queued", "to": "superseded", "trigger": "supersede", "guard": "Plan 失效且任务已被替换", "effects": [] },
        { "id": "E04", "from": "starting", "to": "running", "trigger": "runtime_started", "guard": "Runtime Session 建立并写入首个 Checkpoint", "effects": [] },
        { "id": "E05", "from": "starting", "to": "failed", "trigger": "start_failed", "guard": "建立明确失败", "effects": [] },
        { "id": "E06", "from": "starting", "to": "outcome_unknown", "trigger": "start_timeout", "guard": "超时且无法确认是否已产生副作用", "effects": [] },
        { "id": "E07", "from": "running", "to": "pause_requested", "trigger": "request_pause", "guard": "请求暂停", "effects": [] },
        { "id": "E08", "from": "pause_requested", "to": "paused", "trigger": "checkpoint_saved", "guard": "安全 Checkpoint 已保存", "effects": [] },
        { "id": "E09", "from": "pause_requested", "to": "running", "trigger": "pause_rejected", "guard": "当前无法安全暂停", "effects": [] },
        { "id": "E10", "from": "paused", "to": "queued", "trigger": "resume", "guard": "教师恢复", "effects": [] },
        { "id": "E11", "from": "paused", "to": "cancel_requested", "trigger": "request_cancel", "guard": "请求取消", "effects": [] },
        { "id": "E12", "from": ["queued", "starting", "running", "paused"], "to": "cancel_requested", "trigger": "request_cancel", "guard": "请求取消", "effects": [] },
        { "id": "E13", "from": "cancel_requested", "to": "cancelled", "trigger": "cancellation_confirmed", "guard": "没有活跃 Runtime/Tool，或全部已确认终止", "effects": [] },
        { "id": "E14", "from": "cancel_requested", "to": "cancelling", "trigger": "runtime_acknowledged_cancel", "guard": "Runtime 已接收取消", "effects": [] },
        { "id": "E15", "from": "cancel_requested", "to": "outcome_unknown", "trigger": "cancel_timeout", "guard": "取消确认超时", "effects": [] },
        { "id": "E16", "from": "cancelling", "to": "cancelled", "trigger": "cleanup_complete", "guard": "所有 Tool/Run 进入终止态且清理完成", "effects": [] },
        { "id": "E17", "from": "cancelling", "to": "outcome_unknown", "trigger": "cleanup_unresolved", "guard": "无法确认 Tool/Run 实际结果", "effects": [] },
        { "id": "E18", "from": "running", "to": "succeeded", "trigger": "steps_succeeded", "guard": "全部必需 Step 成功，输出 Hash 与结果已持久化", "effects": [] },
        { "id": "E19", "from": "running", "to": "failed", "trigger": "unrecoverable_failure", "guard": "达到重试上限或出现确定性异常", "effects": [] },
        { "id": "E20", "from": "running", "to": "outcome_unknown", "trigger": "lease_lost", "guard": "Lease 丢失或长时间无有效 Heartbeat", "effects": [] },
        { "id": "E21", "from": "outcome_unknown", "to": "succeeded", "trigger": "reconcile_succeeded", "guard": "对账确认执行完成并产出合法结果", "effects": [] },
        { "id": "E22", "from": "outcome_unknown", "to": "failed", "trigger": "reconcile_failed", "guard": "对账确认执行失败", "effects": [] },
        { "id": "E23", "from": "outcome_unknown", "to": "cancelled", "trigger": "reconcile_cancelled", "guard": "对账确认取消完成", "effects": [] },
        { "id": "E24", "from": ["queued", "starting", "running", "paused"], "to": "superseded", "trigger": "supersede", "guard": "旧执行被替换并完成停止协调", "effects": [] }
      ],
      "invariants": [
        { "id": "E-INV1", "text": "outcome_unknown 不是终止态，但完成状态对账前禁止自动重试。", "source": "§21.6.1" },
        { "id": "E-INV2", "text": "失败或取消后的重试创建新 Execution，通过 retry_of_execution_id 追溯。", "source": "§21.6.1" },
        { "id": "E-INV3", "text": "恢复暂停的 Execution 使用同一 Execution ID，但创建新的 Agent Run。", "source": "§21.6.1" },
        { "id": "E-INV4", "text": "Lease 更新必须携带 Fencing Token；旧 Token 的迟到写入只能作为审计证据。", "source": "§21.6.1" }
      ]
    },
    {
