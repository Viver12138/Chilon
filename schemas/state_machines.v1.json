  "gate_rules": [
    { "id": "GR01", "text": "process_status 不是 succeeded 的 Run 不产生有效发布证据。", "source": "§21.8.2" },
    { "id": "GR02", "text": "stale 是派生属性：目标不再是 Draft 当前 Revision、Content Hash 不匹配、规则政策 Hash 变化或 Validator 版本不再满足门禁时，检查失效。", "source": "§21.8.2" },
    { "id": "GR03", "text": "S0 问题永久阻止发布，不能由教师覆盖。", "source": "§21.8.2" },
    { "id": "GR04", "text": "S1 默认阻止发布；教师显式确认例外时必须保存原因、风险提示、确认人和确认时间，并绑定具体 Revision 与 Gate Snapshot。", "source": "§21.8.2" },
    { "id": "GR05", "text": "S2 由教师决定；S3 不阻止发布但应保留记录。", "source": "§21.8.2" },
    { "id": "GR06", "text": "inconclusive 与 unsupported 在 MVP 中默认阻止发布，除非对应规则明确声明该结果允许。", "source": "§21.8.2" },
    { "id": "GR07", "text": "发布审批必须固定 required_quality_run_ids、required_math_run_ids、规则政策 Hash、Gate Result 与 Gate Snapshot Hash。", "source": "§21.8.2" },
    { "id": "GR08", "text": "单个 LLM 输出“通过”不能作为数学证据；证据必须来自实际 Validator、规则执行或可复现测试。", "source": "§21.8.2" },
    { "id": "GR09", "text": "Teaching Document Schema、AST 语义、Citation 完整性与来源权利是独立于数学质量检查的发布前置门禁。", "source": "§21.8.2" }
  ],
  "events": [
