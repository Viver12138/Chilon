    { "name": "execution.failed", "producer": "K011", "downstream": "Task 进入 needs_attention；未完成产物不得伪装成正式 Draft", "source": "§21.11" },
    { "name": "draft.revision_created", "producer": "K012", "downstream": "旧质量检查、审核和发布授权变为失效", "source": "§21.11" },
    { "name": "quality.gate_completed", "producer": "K014", "downstream": "Draft 进入 changes_required 或 awaiting_review", "source": "§21.11" },
