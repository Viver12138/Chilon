        { "id": "RUN03", "from": "running", "to": "completed", "trigger": "run_completed", "guard": "本次 Run 明确结束", "effects": [] },
        { "id": "RUN04", "from": "running", "to": "failed", "trigger": "run_failed", "guard": "本次 Run 明确失败", "effects": [] },
