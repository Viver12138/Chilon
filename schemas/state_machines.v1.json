      ]
    },
    {
      "id": "step_execution",
      "title": "Step Execution",
      "module": "K011",
      "entity": "agent_step_executions",
      "status_field": "agent_step_executions.status",
      "initial_states": ["pending"],
      "terminal_states": ["succeeded", "failed", "skipped", "cancelled", "superseded"],
      "states": [
        "pending",
        "ready",
        "running",
        "paused",
        "succeeded",
        "failed",
        "blocked",
        "skipped",
        "cancelled",
        "superseded"
      ],
      "source": "§21.6.3",
      "transitions": [
        { "id": "ST01", "from": "pending", "to": "ready", "trigger": "dependencies_satisfied", "guard": "所有 DAG 依赖满足，且 Execution 处于可调度状态", "effects": [] },
        { "id": "ST02", "from": "ready", "to": "running", "trigger": "step_started", "guard": "Step 获得执行权", "effects": [] },
