{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chilon.local/schemas/state_machines.v1.schema.json",
  "title": "Chilon State Machine Registry v1",
  "description": "机器可读的状态机契约格式。跨字段一致性（from/to 必须是已声明状态、终止态不得有出边、初始态必须可达等）由 design/check_state_machines.py 校验，JSON Schema 不表达这些约束。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "title",
    "source",
    "freeze_status",
    "updated_at",
    "governing_fields",
    "common_rules",
    "aggregates",
    "value_sets",
    "gate_rules",
    "events"
  ],
  "properties": {
    "schema": { "const": "chilon.state_machines" },
    "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "title": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 },
    "freeze_status": { "enum": ["DESIGNED", "FROZEN FOR IMPLEMENTATION", "PROPOSED"] },
    "updated_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "notes": { "type": "array", "items": { "type": "string" } },
    "governing_fields": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "state_version"],
      "properties": {
        "status": { "type": "string" },
        "state_version": { "type": "string" },
        "state_changed_at": { "type": "string" },
        "status_reason_code": { "type": "string" },
        "status_reason_optional": { "type": "string" }
      }
    },
    "common_rules": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/rule" } },
    "aggregates": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/aggregate" } },
    "value_sets": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/valueSet" }
    },
    "gate_rules": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/rule" } },
    "events": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/event" } },
    "doc_corrections": { "type": "array", "items": { "$ref": "#/$defs/correction" } }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "source"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z]+-R[0-9]+[A-Z]?$|^GR[0-9]+$" },
        "title": { "type": "string" },
        "text": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 }
      }
    },
    "invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "source"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "to", "trigger", "guard"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "from": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
          ]
        },
        "to": { "type": "string", "minLength": 1 },
        "trigger": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "guard": { "type": "string", "minLength": 1 },
        "effects": { "type": "array", "items": { "type": "string" } }
      }
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "module",
        "entity",
        "status_field",
        "initial_states",
        "terminal_states",
        "states",
        "source",
        "transitions"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "title": { "type": "string", "minLength": 1 },
        "module": { "type": "string", "pattern": "^K0[0-9]{2}$" },
        "entity": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "status_field": { "type": "string", "minLength": 1 },
        "initial_states": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "terminal_states": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "states": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } },
        "source": { "type": "string", "minLength": 1 },
        "transitions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/transition" } },
        "invariants": { "type": "array", "items": { "$ref": "#/$defs/invariant" } }
      }
    },
    "valueSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["values", "source"],
      "properties": {
        "values": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "source": { "type": "string", "minLength": 1 }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "producer", "downstream", "source"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$" },
        "producer": { "type": "string", "minLength": 1 },
        "downstream": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 }
      }
    },
    "correction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "target", "issue", "resolution", "applied"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "issue": { "type": "string", "minLength": 1 },
        "resolution": { "type": "string", "minLength": 1 },
        "applied": { "type": "boolean" }
      }
    }
  }
}
