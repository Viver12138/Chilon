{
  "schema": "chilon.api_surface",
  "schema_version": "1.0.0",
  "title": "Chilon API Surface v1",
  "source": "teacher actions from schemas/actions.v1.json; resources and SSE defined in design volume D5",
  "freeze_status": "FROZEN FOR IMPLEMENTATION",
  "updated_at": "2026-11-04",
  "base_path": "/api/v1",
  "conventions": {
    "versioning": "路径前缀 /api/v1；破坏性变更升 /api/v2，不原地改语义",
    "idempotency": "所有 POST 动作接口接受 Idempotency-Key；相同键重放返回首次结果（200）而非报错",
    "optimistic_locking": "草稿保存使用 If-Match: \"<revision_no>-<content_hash_prefix>\"",
    "state_version": "动作接口必须携带 expected_state_version；不匹配返回 STATE_CONFLICT",
    "pagination": "cursor 分页：?limit=&cursor=，响应带 next_cursor；不提供 offset",
    "errors": "错误结构见 D4 §5.3，必须包含 allowed_actions",
    "auth": "会话 Cookie + Bearer 二选一；跨 Owner 一律 404 而非 403",
    "uploads": "先申请 upload-intent 拿签名 URL，上传完成后再提交审核",
    "downloads": "短时效签名 URL，有效期 10 分钟，不暴露 storage_key"
  },
